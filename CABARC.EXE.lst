.text:010011A1 align 8
.text:010011A8 ; const char aUsageCabarcOpt[]
.text:010011A8 aUsageCabarcOpt db 'Usage: CABARC [options] command cab'
.text:010011A8 db 'file [@list] [files] [dest_dir]',0Ah
.text:010011A8 db 0Ah
.text:010011A8 db 'Commands:',0Ah
.text:010011A8 db '   L   List contents of cabinet (e.'
.text:010011A8 db 'g. cabarc l test.cab)',0Ah
.text:010011A8 db '   N   Create new cabinet (e.g. cab'
.text:010011A8 db 'arc n test.cab *.c app.mak *.h)',0Ah
.text:010011A8 db '   X   Extract file(s) from cabinet'
.text:010011A8 db ' (e.g. cabarc x test.cab foo*.c)',0Ah
.text:010011A8 db 0Ah
.text:010011A8 db 'Options:',0Ah
.text:010011A8 db '  -c   Confirm files to be operated'
.text:010011A8 db ' on',0Ah
.text:010011A8 db '  -o   When extracting, overwrite w'
.text:010011A8 db 'ithout asking for confirmation',0Ah
.text:010011A8 db '  -m   Set compression type [LZX:<1'
.text:010011A8 db '5..21>|MSZIP|NONE], (default is MSZ'
.text:010011A8 db 'IP)',0Ah
.text:010011A8 db '  -p   Preserve path names (absolut'
.text:010011A8 db 'e paths not allowed)',0Ah
.text:010011A8 db '  -P   Strip specified prefix from '
.text:010011A8 db 'files when added',0Ah
.text:010011A8 db '  -r   Recurse into subdirectories '
.text:010011A8 db 'when adding files (see -p also)',0Ah
.text:010011A8 db '  -s   Reserve space in cabinet for'
.text:010011A8 db ' signing (e.g. -s 6144 reserves 6K '
.text:010011A8 db 'bytes)',0Ah
.text:010011A8 db '  -i   Set cabinet set ID when crea'
.text:010011A8 db 'ting cabinets (default is 0)',0Ah
.text:010011A8 db '  -d   Set diskette size (default i'
.text:010011A8 db 's no limit/single CAB)',0Ah
.text:010011A8 db 0Ah
.text:010011A8 db 'Notes',0Ah
.text:010011A8 db '-----',0Ah
.text:010011A8 db 'When creating a cabinet, the plus s'
.text:010011A8 db 'ign (+) may be used as a filename',0Ah
.text:010011A8 db 'to force a folder boundary; e.g. ca'
.text:010011A8 db 'barc n test.cab *.c test.h + *.bmp',0Ah
.text:010011A8 db 0Ah
.text:010011A8 db 'When extracting files to disk, the '
.text:010011A8 db '<dest_dir>, if provided, must end i'
.text:010011A8 db 'n',0Ah
.text:010011A8 db 'a backslash; e.g. cabarc x test.cab'
.text:010011A8 db ' bar*.cpp *.h d:\test\',0Ah
.text:010011A8 db 0Ah
.text:010011A8 db 'The -P (strip prefix) option can be'
.text:010011A8 db ' used to strip out path information'
.text:010011A8 db 0Ah
.text:010011A8 db 'e.g. cabarc -r -p -P myproj\ a test'
.text:010011A8 db '.cab myproj\balloon\*.*',0Ah
.text:010011A8 db 'The -P option can be used multiple '
.text:010011A8 db 'times to strip out multiple paths',0Ah
.text:010011A8 db 0Ah
.text:010011A8 db 'When creating cabinet sets using -d'
.text:010011A8 db ', the cabinet name should contain',0Ah
.text:010011A8 db 'a single ',27h,'*',27h,' character '
.text:010011A8 db 'where the cabinet number will be in'
.text:010011A8 db 'serted.',0Ah
.text:010011A8 db 0Ah,0
